# Universal Configurator - hosting compartido
# Úsalo cuando subes TODA la carpeta del proyecto a public_html.
# (Lo ideal es apuntar el dominio a la subcarpeta public/; si puedes, hazlo y este archivo no se usará.)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pasar la cabecera Authorization a PHP (MCP)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Bloquear carpetas y archivos internos
    RewriteRule ^(app|data|bin|deploy|docs|tests)(/|$) - [F,L,NC]
    RewriteRule ^(README\.md|CHANGELOG\.md|CONTRIBUTING\.md|LICENSE|composer\.json|composer\.lock|install\.sh|\.gitignore|\.git)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known)  - [F,L]
    RewriteRule \.(sqlite3?|bak|sql)$ - [F,L,NC]

    # Ya dentro de public/: no reescribir de nuevo (evita bucles)
    RewriteRule ^public/ - [L]

    # Todo lo demás se sirve desde public/ (REQUEST_URI no cambia, la app enruta por él)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^ public%{REQUEST_URI} [L]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteCond %{REQUEST_URI} !^/$
    RewriteRule ^ public%{REQUEST_URI} [L]
    RewriteRule ^ public/index.php [L]
</IfModule>

# Si mod_rewrite no existe, al menos no exponer nada sensible: las carpetas internas dan 404 (mod_alias) y, por si
# acaso, nada de bases, copias (.zip, .ucbk), registros ni PHP de fuera de public/.
<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 404 ^/(app|data|bin|deploy|docs|tests)(/|$)
    </IfModule>
    <FilesMatch "\.(sqlite|sqlite3|sqlite-wal|sqlite-shm|php|md|json|tmp|zip|ucbk|log|bak|sql)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
    </FilesMatch>
</IfModule>
# OJO: con «AllowOverride None» Apache no lee NINGÚN .htaccess (ni este ni el de data/). Apunta el dominio a public/
# (lo recomendado) o permite .htaccess en esta carpeta; si no, data/ quedaría a la vista.
